# Backend API Gateway URL
# 로컬 개발 환경에서는 API Gateway의 주소를 입력하세요
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# JWT 검증용 시크릿 (미들웨어에서 사용)
# 백엔드와 동일한 시크릿을 사용해야 합니다
# 실제 환경에서는 강력한 랜덤 문자열을 사용하세요
JWT_SECRET=your-jwt-secret-here

# Queue Token 검증용 시크릿 (미들웨어에서 사용)
# 백엔드와 동일한 시크릿을 사용해야 합니다
QUEUE_TOKEN_SECRET=your-queue-token-secret-here

# PortOne V2 본인인증
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=your-portone-channel-key
NEXT_PUBLIC_PORTONE_STORE_ID=your-portone-store-id

# Google reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# ===========================
# 참고사항
# ===========================
# 1. 이 파일을 .env.local로 복사하여 실제 값을 입력하세요
# 2. .env.local 파일은 .gitignore에 포함되어 있어 커밋되지 않습니다
# 3. JWT_SECRET과 QUEUE_TOKEN_SECRET은 백엔드 application.yml과 일치해야 합니다
# 4. env vars 미설정 시 middleware는 모든 인증 경로를 /login으로 안전하게 리디렉트합니다
# 5. PortOne/reCAPTCHA 키는 docker/secrets/ 디렉토리의 시크릿 파일과 동일한 값을 사용합니다
#    - NEXT_PUBLIC_PORTONE_STORE_ID   ← docker/secrets/portone_store_id.txt
#    - NEXT_PUBLIC_PORTONE_CHANNEL_KEY ← docker/secrets/portone_channel_key.txt
#    - NEXT_PUBLIC_RECAPTCHA_SITE_KEY ← Google reCAPTCHA 콘솔에서 발급 (공개 site key, Docker secret 아님)
