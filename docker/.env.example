COMPOSE_PROJECT_NAME=your_project_name_here

# PostgreSQL 설정
POSTGRES_DB=your_db_here
POSTGRES_USER=your_user_here

# ===========================
# Docker Secrets 파일 필요 목록
# ===========================
# docker/secrets/ 디렉토리에 아래 .txt 파일들을 생성해야 합니다:
#
# [Database 비밀번호] — 로컬 개발 시 임의 문자열 가능
# - postgres_ticket_pw.txt       (PostgreSQL 관리자 비밀번호)
# - postgres_user_pw.txt         (User Service DB 비밀번호)
# - postgres_event_pw.txt        (Event Service DB 비밀번호)
# - postgres_reservation_pw.txt  (Reservation Service DB 비밀번호)
# - postgres_payment_pw.txt      (Payment Service DB 비밀번호)
# - valkey_pw.txt                (Valkey/Redis 비밀번호)
#
# [인증/보안] — 로컬 개발 시 임의 문자열 가능
# - jwt_secret.txt               (JWT 서명 시크릿)
# - internal_api_key.txt         (서비스 간 내부 API 인증 키)
# - enc_secret_key.txt           (AES 암호화 키)
# - enc_hash_salt.txt            (SHA-256 해시 솔트)
#
# [외부 서비스 API 키] — 실제 발급받은 키 필요
# - portone_api_secret.txt       (PortOne API Secret - Backend 전용)
# - portone_store_id.txt         (PortOne Store ID - Frontend/Backend 공유)
# - portone_channel_key.txt      (PortOne Channel Key - Frontend/Backend 공유)
# - recaptcha_secret.txt         (reCAPTCHA Secret Key - Backend 전용)
#
# [Grafana 모니터링]
# - grafana_admin_pw.txt         (Grafana 관리자 비밀번호 — 공유/스테이징/운영 환경에서는 반드시 강력한 비밀번호로 변경)
#
# ===========================
# Grafana 환경 변수
# ===========================
# GF_ADMIN_USER=admin            (Grafana 관리자 계정명, 기본값: admin)
